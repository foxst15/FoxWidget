<resources>
    <style name="Theme.FoxWidget" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/fox_primary</item>
        <item name="colorPrimaryVariant">@color/fox_primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/fox_primary</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">@color/fox_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Nút bo tròn hoàn toàn -->
    <style name="Fox.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Fox.Button.Filled">
        <item name="backgroundTint">@color/fox_primary</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="Fox.Button.Tonal">
        <item name="backgroundTint">@color/fox_tile</item>
        <item name="android:textColor">@color/fox_primary</item>
        <item name="rippleColor">#336C47FF</item>
    </style>
    <style name="Fox.Button.Small">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Fox.Shape.Logo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Fox.Shape.LogoLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>
</resources>
