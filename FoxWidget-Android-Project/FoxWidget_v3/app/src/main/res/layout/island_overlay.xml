<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:contentDescription="Dynamic Island FoxWidget">

    <LinearLayout
        android:id="@+id/island_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_island"
        android:orientation="vertical">

        <!-- Thu gọn: viên thuốc, tự luân phiên các thông tin đã chọn -->
        <LinearLayout
            android:id="@+id/island_collapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="110dp"
            android:minHeight="34dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">
            <ImageView
                android:id="@+id/island_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/island_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:ellipsize="end"
                android:maxWidth="180dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mở rộng: hiện đủ các thông tin đã chọn -->
        <LinearLayout
            android:id="@+id/island_expanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="250dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
        <LinearLayout
            android:id="@+id/island_row_cal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/island_ic_cal"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/island_lbl_cal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lịch"
                    android:textColor="#9A94B5"
                    android:textSize="10.5sp" />
                <TextView
                    android:id="@+id/island_val_cal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/island_row_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/island_ic_weather"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/island_lbl_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thời tiết"
                    android:textColor="#9A94B5"
                    android:textSize="10.5sp" />
                <TextView
                    android:id="@+id/island_val_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/island_row_loc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/island_ic_loc"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/island_lbl_loc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vị trí"
                    android:textColor="#9A94B5"
                    android:textSize="10.5sp" />
                <TextView
                    android:id="@+id/island_val_loc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/island_row_bat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/island_ic_bat"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/island_lbl_bat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pin &amp; nhiệt độ"
                    android:textColor="#9A94B5"
                    android:textSize="10.5sp" />
                <TextView
                    android:id="@+id/island_val_bat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
