<?xml version="1.0" encoding="utf-8"?>
<!-- Dynamic Island: kích thước cửa sổ và vị trí do IslandOverlayManager tính theo camera của máy -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="Dynamic Island FoxWidget">

    <!-- Thu gọn: [icon app] ...... (trống cho camera) ...... [thông tin] -->
    <FrameLayout
        android:id="@+id/island_collapsed"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/island_left_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
        <TextView
            android:id="@+id/island_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:ellipsize="end"
            android:gravity="end"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Mở rộng: thẻ thông tin đầy đủ -->
    <LinearLayout
        android:id="@+id/island_expanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">
            <ImageView
                android:id="@+id/island_exp_logo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/fox_logo" />
            <TextView
                android:id="@+id/island_exp_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="FoxWidget"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/island_row_cal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="5dp">
            <ImageView
                android:id="@+id/island_ic_cal"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/island_lbl_cal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lịch"
                    android:textColor="#9A94B5"
                    android:textSize="10.5sp" />
                <TextView
                    android:id="@+id/island_val_cal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/island_row_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="5dp">
            <ImageView
                android:id="@+id/island_ic_weather"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/island_lbl_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thời tiết"
                    android:textColor="#9A94B5"
                    android:textSize="10.5sp" />
                <TextView
                    android:id="@+id/island_val_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/island_row_loc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="5dp">
            <ImageView
                android:id="@+id/island_ic_loc"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/island_lbl_loc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vị trí"
                    android:textColor="#9A94B5"
                    android:textSize="10.5sp" />
                <TextView
                    android:id="@+id/island_val_loc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/island_row_bat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="5dp">
            <ImageView
                android:id="@+id/island_ic_bat"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/island_lbl_bat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pin &amp; nhiệt độ"
                    android:textColor="#9A94B5"
                    android:textSize="10.5sp" />
                <TextView
                    android:id="@+id/island_val_bat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
