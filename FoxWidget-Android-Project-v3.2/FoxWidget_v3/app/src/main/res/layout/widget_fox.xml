<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:id="@+id/iv_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_widget_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20:10"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:shadowColor="#40000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_solar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Thứ Tư, 25 tháng 11"
                    android:textColor="#E6EAF5"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tv_widget_lunar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Âm lịch: 17 tháng 10"
                    android:textColor="#E6EAF5"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.85"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_widget_device"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Redmi K70"
                        android:textColor="#D0D8EE"
                        android:textSize="10.5sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_widget_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24°"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_widget_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="📍 Quảng Ngãi"
                    android:textColor="#E6EAF5"
                    android:textSize="11.5sp"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_widget_battery_pct"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔋 85%"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_widget_refresh_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:text="↻"
                        android:textColor="#E6EAF5"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_widget_battery_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="🌡️ 35.8°C"
                    android:textColor="#E6EAF5"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_week_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout android:id="@+id/ll_w_col_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="3dp">
                <TextView android:id="@+id/tv_w_dow_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T2" android:textSize="10sp" android:textColor="#C5CEE6"/>
                <TextView android:id="@+id/tv_w_sol_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23" android:textSize="13.5sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tv_w_lun_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15" android:textSize="9.5sp" android:textColor="#C5CEE6"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_w_col_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="3dp">
                <TextView android:id="@+id/tv_w_dow_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T3" android:textSize="10sp" android:textColor="#C5CEE6"/>
                <TextView android:id="@+id/tv_w_sol_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24" android:textSize="13.5sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tv_w_lun_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16" android:textSize="9.5sp" android:textColor="#C5CEE6"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_w_col_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="3dp">
                <TextView android:id="@+id/tv_w_dow_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T4" android:textSize="10sp" android:textColor="#C5CEE6"/>
                <TextView android:id="@+id/tv_w_sol_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textSize="13.5sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tv_w_lun_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17" android:textSize="9.5sp" android:textColor="#C5CEE6"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_w_col_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="3dp">
                <TextView android:id="@+id/tv_w_dow_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T5" android:textSize="10sp" android:textColor="#C5CEE6"/>
                <TextView android:id="@+id/tv_w_sol_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="26" android:textSize="13.5sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tv_w_lun_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18" android:textSize="9.5sp" android:textColor="#C5CEE6"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_w_col_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="3dp">
                <TextView android:id="@+id/tv_w_dow_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T6" android:textSize="10sp" android:textColor="#C5CEE6"/>
                <TextView android:id="@+id/tv_w_sol_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="27" android:textSize="13.5sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tv_w_lun_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19" android:textSize="9.5sp" android:textColor="#C5CEE6"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_w_col_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="3dp">
                <TextView android:id="@+id/tv_w_dow_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T7" android:textSize="10sp" android:textColor="#C5CEE6"/>
                <TextView android:id="@+id/tv_w_sol_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="28" android:textSize="13.5sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tv_w_lun_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20" android:textSize="9.5sp" android:textColor="#C5CEE6"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_w_col_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="3dp">
                <TextView android:id="@+id/tv_w_dow_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CN" android:textSize="10sp" android:textColor="#C5CEE6"/>
                <TextView android:id="@+id/tv_w_sol_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="29" android:textSize="13.5sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tv_w_lun_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21" android:textSize="9.5sp" android:textColor="#C5CEE6"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
